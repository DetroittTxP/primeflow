# Copy to server.env on the control-plane VM and chmod 600 — it holds the DSN,
# the machine token and the seed password.
#
#   cp server.env.example server.env && chmod 600 server.env
#
# Every CHANGE_ME below has to change. POSTGRES_PASSWORD must match what the
# compose file gets for the postgres service (put it in a .env beside the
# compose file, or export it in the shell).

PRIMEFLOW_DATABASE_URL=postgres://primeflow:CHANGE_ME@postgres:5432/primeflow?sslmode=disable
# sslmode=disable is correct here and only here: the connection never leaves
# the compose network. Point this at a managed database and it becomes require.

# Machine clients (the primeflow CLI, scripts). Not a worker credential —
# workers use pool-scoped api-worker keys issued from the console.
PRIMEFLOW_API_TOKEN=CHANGE_ME

# Seeds the first operator account, on an empty database only. Ignored once any
# user exists, so it is safe to leave in place.
PRIMEFLOW_ADMIN_EMAIL=admin@example.com
PRIMEFLOW_ADMIN_PASSWORD=CHANGE_ME

# The compose network's pinned subnet. This is what lets the server believe
# X-Forwarded-For from nginx, and it implies Secure session cookies. Keep it in
# step with the `pf` network in docker-compose.yml.
PRIMEFLOW_TRUSTED_PROXY_CIDRS=172.31.240.0/24

PRIMEFLOW_SESSION_TTL=168h
PRIMEFLOW_LOG_RETENTION=720h
PRIMEFLOW_LOG_LEVEL=info

# Deliberately not set: PRIMEFLOW_HTTP_ADDR. The default :8080 binds every
# interface *inside the container*, which is what nginx needs to reach it.
# Setting it to 127.0.0.1:8080 — correct for a systemd deployment — would bind
# the container's own loopback and nginx would get connection refused.
