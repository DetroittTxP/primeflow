# Copy to worker.env on the worker VM and chmod 600 — it holds the pool key.
#
#   cp worker.env.example worker.env && chmod 600 worker.env
#
# This is the whole configuration of a worker VM. There is no database
# credential here and there should never be one.

# Must match the certificate's SAN exactly. Dialling the IP instead will fail
# TLS verification even when the address is right.
PRIMEFLOW_API_URL=https://mainvm.example.com

# A pool-scoped api-worker key. Issue it from the console (Workers → Add
# worker… → Issue key…) or with sites/issue-keys.sh. Rotating it means editing
# this file and `docker compose up -d --force-recreate` — a plain `restart`
# keeps the old value, because Compose bakes env_file into the container when
# it is created.
PRIMEFLOW_WORKER_TOKEN=pmx_CHANGE_ME

# Must be inside the key's pools. A lane outside them is dropped from every
# lease with no error, so a mismatched worker looks healthy and never takes
# work. Comma-separated for more than one.
PRIMEFLOW_QUEUES=vm2

PRIMEFLOW_WORKER_NAME=vm2
PRIMEFLOW_CONCURRENCY=4
PRIMEFLOW_LEASE=60s

# The only port a worker opens. Container-local here; publish it in the compose
# file if Prometheus scrapes this VM.
PRIMEFLOW_METRICS_ADDR=:9090

# Trust the control plane's self-signed certificate. This *replaces* the system
# root pool for this process, which is fine for a worker that talks to one
# host — drop this line when the server presents a publicly trusted
# certificate.
SSL_CERT_FILE=/certs/server.crt

# Deliberately absent: PRIMEFLOW_DATABASE_URL. Set alongside the API variables
# it is ignored with a warning, but the point is that this VM should not hold a
# credential it cannot use.
