# Copy to .env beside docker-compose.yml and edit every CHANGE_ME.
#
#   cp .env.example .env && chmod 600 .env
#
# Compose reads this file automatically. It holds the database password, the
# first operator's password and the machine token, so it does not belong in
# version control.

# ---------------------------------------------------------------- image ---

# The image both the server and the stock worker run. Pin a tag rather than
# `latest`, so a rollback is a tag and not a question about what was pulled
# when. Build it yourself from a checkout of the repository with `make docker`
# if you are not pulling from a registry.
PRIMEFLOW_IMAGE=detroitttttxp/primeflow:latest

# ------------------------------------------------------------- secrets ---

# Keep this to letters and digits: it is substituted straight into a postgres://
# DSN, where a @ or a / would be read as DSN syntax rather than as password.
POSTGRES_PASSWORD=CHANGE_ME

# The first operator account, created on an empty database only.
PRIMEFLOW_ADMIN_EMAIL=admin@example.com
PRIMEFLOW_ADMIN_PASSWORD=CHANGE_ME

# Bearer token for machine clients (the primeflow CLI, your scripts). Leave
# empty to require an admin session on those routes instead. This is not a
# worker credential — workers use pool-scoped keys issued from the console.
PRIMEFLOW_API_TOKEN=

# --------------------------------------------------------------- server ---

# Host port the console and API are published on.
PRIMEFLOW_HTTP_PORT=8080

PRIMEFLOW_SESSION_TTL=168h
PRIMEFLOW_LOG_RETENTION=720h
PRIMEFLOW_LOG_LEVEL=info

# --------------------------------------------------------------- worker ---

# Lanes the bundled example worker serves. A worker creates the lanes it names,
# so these appear in the console on the first start with no seeding step.
PRIMEFLOW_QUEUES=default,vcd,metering
PRIMEFLOW_CONCURRENCY=4

# Your own worker image, once you have built one from ./worker.
# MY_WORKER_IMAGE=my-worker:dev
